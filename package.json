{
  "name": "trial-gardens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK_DATA=1 next dev",
    "dev:admin": "NEXT_PUBLIC_MOCK_DATA=1 NEXT_PUBLIC_ADMIN_API_URL=http://127.0.0.1:3001/api/admin next dev",
    "admin:server": "node --env-file-if-exists=.env.local scripts/admin-server.mjs",
    "mock": "node scripts/mock-data.mjs",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_MOCK_DATA=1 next build",
    "build:demo": "NEXT_PUBLIC_MOCK_DATA=1 NEXT_PUBLIC_ADMIN_DEMO=1 next build",
    "test": "playwright test",
    "start": "next start",
    "lint": "next lint",
    "import": "node scripts/import-xlsx.mjs",
    "mirror": "node scripts/mirror-images.mjs",
    "photos": "node scripts/import-photos.mjs",
    "weather": "NODE_USE_ENV_PROXY=1 node scripts/weather.mjs",
    "dropbox:auth": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local scripts/dropbox-auth.mjs",
    "dropbox:photos": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local scripts/dropbox-photos.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
