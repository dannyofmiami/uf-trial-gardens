# Copy to .env.local (git-ignored) and fill in.

# Shared password for /admin (12+ characters). In production this lives in AWS
# Secrets Manager / SSM, never in the site's code.
ADMIN_PASSWORD=
# Random string that signs admin sessions, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Dropbox photo downloads (see README)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
